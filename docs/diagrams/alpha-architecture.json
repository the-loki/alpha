  "cards": [
    {
      "dot": "cyan",
      "title": "两条传输，一份处理函数",
      "items": [
        "桌面窗口走 ipcMain，浏览器走 HTTP + SSE，两边由同一张通道表回答",
        "推送从 Broadcast 出去，窗口与一个浏览器是同一种订阅者",
        "浏览器是远程控制端：能审批、能改等级、能读全部对话"
      ]
    },
    {
      "dot": "rose",
      "title": "闸门在主进程里，窗口只负责展示",
      "items": [
        "四级权限：plan / ask / accept-edits / full-access",
        "记住的规则写在盘上，规则优先于等级，连 plan 也拦不住它",
        "每个决定落到 decisions/<id>.json，重开的台账仍然说得清"
      ]
    },
    {
      "dot": "emerald",
      "title": "盘上是唯一的记录",
      "items": [
        "会话是追加写的 JSONL，pi 时代的转录就地读、不转换",
        "密钥加密后只进不出：窗口设得了，读不回",
        "删对话就删会话目录与决策日志"
      ]
    }
  ]
