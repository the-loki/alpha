{
  "name": "alpha",
  "version": "0.1.0",
  "description": "A local-first desktop workbench for a pi agent",
  "author": "the-loki",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "check:constraints": "node tools/constraints/check.mjs",
    "check": "pnpm check:constraints && pnpm typecheck && pnpm lint && pnpm test",
    "package": "pnpm build && electron-builder",
    "package:linux": "pnpm build && electron-builder --linux",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.19",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
